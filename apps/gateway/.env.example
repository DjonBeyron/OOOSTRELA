# Скопировать в .env рядом (apps/gateway/.env) и поменять при необходимости.

# Где слушает gateway. 127.0.0.1 = только этот ПК (наружу — позже через туннель).
HOST=127.0.0.1
PORT=8787

# Ollama и модель
OLLAMA_URL=http://127.0.0.1:11434
MODEL=qwen3:30b-a3b
# Сколько держать модель в видеопамяти после последнего запроса
KEEP_ALIVE=30m
# Рассуждения модели: true = умнее, но первое слово позже; false = быстрее.
# Пользователь их не видит в любом случае, админ — видит в #admin.
THINK=true
# Окно контекста (токены): сколько текста модель видит за раз — диалог + приложенный файл.
# Больше = длиннее файлы, но больше видеопамяти. 16384 ≈ 40 страниц текста.
NUM_CTX=16384

# Пусто = без токена (этап 0, локально). На этапе 2 задать длинную случайную строку.
GATEWAY_TOKEN=
