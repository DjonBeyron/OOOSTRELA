{
  "name": "strela-ai",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w @strela/web",
    "dev:gateway": "npm run dev -w @strela/gateway",
    "build": "npm run build -w @strela/web",
    "start": "npm run start -w @strela/gateway",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && node scripts/check-lines.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
